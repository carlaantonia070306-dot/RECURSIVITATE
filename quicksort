#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>

void quicksort(int v[], int st, int dr)
{
    int i = st;
    int j = dr;
    int pivot = v[(st + dr) / 2];

    while (i <= j)
    {
        while (v[i] < pivot)
            i++;

        while (v[j] > pivot)
            j--;

        if (i <= j)
        {
            int aux = v[i];
            v[i] = v[j];
            v[j] = aux;

            i++;
            j--;
        }
    }

    if (st < j)
        quicksort(v, st, j);

    if (i < dr)
        quicksort(v, i, dr);
}

int main()
{
    int n, v[100];

    printf("n = ");
    scanf("%d", &n);

    printf("Elementele vectorului:\n");

    for (int i = 0; i < n; i++)
        scanf("%d", &v[i]);

    quicksort(v, 0, n - 1);

    printf("Vectorul sortat:\n");

    for (int i = 0; i < n; i++)
        printf("%d ", v[i]);

    return 0;
}
