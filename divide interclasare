#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>

void interclasare(int v[], int st, int mij, int dr)
{
    int i = st;
    int j = mij + 1;
    int k = 0;
    int aux[100];

    while (i <= mij && j <= dr)
    {
        if (v[i] < v[j])
            aux[k++] = v[i++];
        else
            aux[k++] = v[j++];
    }

    while (i <= mij)
        aux[k++] = v[i++];

    while (j <= dr)
        aux[k++] = v[j++];

    for (i = st, k = 0; i <= dr; i++, k++)
        v[i] = aux[k];
}

void mergeSort(int v[], int st, int dr)
{
    if (st < dr)
    {
        int mij = (st + dr) / 2;

        mergeSort(v, st, mij);
        mergeSort(v, mij + 1, dr);

        interclasare(v, st, mij, dr);
    }
}

int main()
{
    int v[100], n;

    printf("n = ");
    scanf("%d", &n);

    printf("Elementele vectorului:\n");
    for (int i = 0; i < n; i++)
        scanf("%d", &v[i]);

    mergeSort(v, 0, n - 1);

    printf("Vector sortat:\n");
    for (int i = 0; i < n; i++)
        printf("%d ", v[i]);

    return 0;
}
