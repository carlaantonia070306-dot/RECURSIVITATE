#include <stdio.h>

int v[100], aux[100];

void interclasare(int st, int mij, int dr)
{
    int i = st, j = mij + 1, k = st;

    while (i <= mij && j <= dr)
    {
        if (v[i] <= v[j])
            aux[k++] = v[i++];
        else
            aux[k++] = v[j++];
    }

    while (i <= mij)
        aux[k++] = v[i++];

    while (j <= dr)
        aux[k++] = v[j++];

    for (i = st; i <= dr; i++)
        v[i] = aux[i];
}

void mergeSort(int st, int dr)
{
    if (st >= dr)
        return;

    int mij = (st + dr) / 2;

    mergeSort(st, mij);
    mergeSort(mij + 1, dr);

    interclasare(st, mij, dr);
}

int main()
{
    int n;

    printf("n = ");
    scanf("%d", &n);

    for (int i = 0; i < n; i++)
        scanf("%d", &v[i]);

    mergeSort(0, n - 1);

    for (int i = 0; i < n; i++)
        printf("%d ", v[i]);

    return 0;
}
