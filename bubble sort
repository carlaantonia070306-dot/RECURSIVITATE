
#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>

void sortare_bule(float v[], int nr)
{
    int gata = 0;
    float aux;

    for (int i = 0; i < nr - 1; i++)
    {
        if (v[i] > v[i + 1])
        {
            aux = v[i];
            v[i] = v[i + 1];
            v[i + 1] = aux;
            gata = 1;
        }
    }

    if (gata == 1)
        sortare_bule(v, nr);
}

int main()
{
    float v[50];
    int nr, i;

    printf("Numarul de elemente ale vectorului: ");
    scanf("%d", &nr);

    printf("Introduceti elementele vectorului:\n");
    for (i = 0; i < nr; i++)
        scanf("%f", &v[i]);

    sortare_bule(v, nr);

    printf("Vector sortat: ");
    for (i = 0; i < nr; i++)
        printf("%.2f ", v[i]);

    return 0;
}
