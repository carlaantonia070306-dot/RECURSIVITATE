#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>

void suma_vector(float v[], int nr, float& s)
{
    if (nr == 0)
        return;

    s=s+ v[nr - 1];
    suma_vector(v, nr - 1, s);
}

int main()
{
    float v[50], s = 0;
    int nr, i;

    printf("Introduceti numarul de elemente: ");
    scanf("%d", &nr);

    printf("Introduceti elementele vectorului:\n");
    for (i = 0; i < nr; i++)
        scanf("%f", &v[i]);

    suma_vector(v, nr, s);

    printf("Suma elementelor vectorului este: %.2f\n", s);

    return 0;
}
